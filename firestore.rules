rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isDeveloper() {
      return signedIn() && (
        request.auth.token.role == "developer" ||
        request.auth.token.appRole == "developer" ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "developer" ||
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
          )
        )
      );
    }

    // Main user document:
    // users/{uid}
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      // User progress subcollections:
      // users/{uid}/roadmapProgress/main
      // users/{uid}/nodeProgress/{nodeId}
      // users/{uid}/habitLogs/{date}
      // users/{uid}/problemProgress/{problemId}
      // users/{uid}/quizAttempts/{attemptId}
      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Developer profile used by your current code:
    // developer/profile
    match /developer/profile {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    // Optional old path, only if some old code/settings still use it
    match /siteSettings/developerProfile {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    // Admin/developer role documents
    // Create admins/{uid} manually from Firebase Console only
    match /admins/{userId} {
      allow read: if isOwner(userId) || isDeveloper();
      allow write: if false;
    }

    // Optional old role paths
    match /roles/{userId} {
      allow read: if isOwner(userId) || isDeveloper();
      allow write: if false;
    }

    match /roleEmails/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // Public learning/catalog content
    match /roadmaps/{document=**} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    match /resources/{document=**} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    match /problems/{document=**} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    match /quizzes/{document=**} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}